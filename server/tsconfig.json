{
  "compilerOptions": {
    "target": "es2020", "composite": true, "declaration": true,
    "outDir": "./dist", "module": "commonjs", "moduleResolution": "node",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "rootDir": "./src", "noUnusedLocals": false, "noUnusedParameters": false
  },
  "include": ["./src/**/*.ts"], "exclude": ["node_modules"]
}
